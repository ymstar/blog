---
---

<section class="relative overflow-hidden bg-surface-subtle">
  <div class="container-page flex flex-col items-center gap-8 py-20 sm:py-28 lg:flex-row lg:justify-between">
    <!-- 文字区 -->
    <div class="flex flex-col items-center gap-4 text-center lg:items-start lg:text-left">
      <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        Hi, I'm 阿呆
        <span class="inline-block animate-wave">👋</span>
      </h1>
      <p class="text-lg text-ink-light sm:text-xl">
        Software Engineer & Indie Maker
      </p>
      <p class="max-w-md text-base text-ink-muted">
        一个不务正业的程序员，不愿躺平的年轻人。如果你和我一样不愿待在舒适区，欢迎一起交流学习。
      </p>
      <div class="flex items-center gap-4 pt-2">
        <a
          href="https://github.com/ymstar"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-btn bg-ink px-5 py-2.5 text-sm font-medium text-white hover:bg-ink-light"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
          GitHub
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 rounded-btn border border-surface-border px-5 py-2.5 text-sm font-medium text-ink hover:border-accent hover:text-accent"
        >
          读博客 →
        </a>
      </div>
    </div>

    <!-- 个人照片 -->
    <div class="relative shrink-0">
      <div class="absolute inset-0 -z-10 rounded-card bg-gradient-to-br from-accent-light to-accent opacity-20 blur-2xl"></div>
      <img
        src="/photo.png"
        alt="阿呆"
        class="h-48 w-40 rounded-card border-4 border-surface object-cover shadow-xl sm:h-64 sm:w-52"
      />
    </div>
  </div>
</section>

<style>
  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(15deg); }
    75% { transform: rotate(-10deg); }
  }
  .animate-wave {
    animation: wave 2s ease-in-out infinite;
    transform-origin: 70% 70%;
  }
</style>
