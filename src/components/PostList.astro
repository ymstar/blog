---
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const categoryColors: Record<string, string> = {
  '并发': 'bg-blue-100 text-blue-700',
  'java': 'bg-orange-100 text-orange-700',
  'Java': 'bg-orange-100 text-orange-700',
  'java源码': 'bg-amber-100 text-amber-700',
  'Docker': 'bg-cyan-100 text-cyan-700',
  'Linux': 'bg-green-100 text-green-700',
  'Spring': 'bg-green-100 text-green-700',
  'Temporal': 'bg-violet-100 text-violet-700',
  '博客搭建': 'bg-pink-100 text-pink-700',
  '设计模式': 'bg-purple-100 text-purple-700',
  'DevOps': 'bg-indigo-100 text-indigo-700',
};
const defaultColor = 'bg-slate-100 text-slate-700';
---

<section class="container-page py-16 sm:py-20">
  <div class="mb-10 flex items-end justify-between">
    <div>
      <h2 class="text-2xl font-bold text-ink sm:text-3xl">最新文章</h2>
      <p class="mt-2 text-sm text-ink-muted">偶尔写点东西，大多是技术笔记</p>
    </div>
    <a href="/blog" class="link-accent text-sm font-medium">
      查看全部 →
    </a>
  </div>

  <div class="grid gap-3">
    {posts.map((post) => (
      <a
        href={`/blog/${post.slug}`}
        class="card card-hover group flex items-center gap-4 p-5"
      >
        <time class="shrink-0 text-sm font-medium text-ink-muted tabular-nums">
          {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
        </time>
        <span class="h-8 w-px shrink-0 bg-surface-border"></span>
        <span class="flex-1 text-base font-medium text-ink group-hover:text-accent transition-colors">
          {post.data.title}
        </span>
        <span class={`shrink-0 rounded-full px-2.5 py-1 text-xs font-medium ${categoryColors[post.data.category] || defaultColor}`}>
          {post.data.category}
        </span>
      </a>
    ))}
  </div>
</section>
