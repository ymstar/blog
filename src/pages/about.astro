---
import Base from '../layouts/Base.astro';

// 公司线：DevOps / 后端经历
const workExperiences = [
  {
    period: '2020.07 — 至今',
    role: 'DevOps 平台开发工程师',
    highlights: [
      '从 0 到 1 搭建公司 CI 体系（Jenkins + K8s + 自研 CI 系统），支撑 200+ 开发者日常构建，日均 1500+ 次、单日峰值 5173 次',
      '主导 DevOps 系统的任务管理与制品管理模块，覆盖 300+ 研发测试人员，上线效率从 8~10 小时提升至 1 小时',
      '连续两年获得年度 B 绩效',
    ],
  },
  {
    period: '2020 年初',
    role: '百度 · 实习生（三个月）',
    highlights: ['入职前实习，参与日常开发与维护，完成从校园到工业界工程的过渡'],
  },
];

// AI 工程实践：不只是用工具，更是搭体系
const teamAgent = {
  title: '公司内部 TeamAgent（团队级项目，主导）',
  summary:
    '对接 GitLab，打通 issue 分析 → 方案设计 → 代码开发 → MR 创建 → CodeReview 全流程。项目含 4 个 MCP server、20+ 工具，基于多 Agent 编排实现多角色协作，支持 Claude、Codex、Cursor 等 7 个 AI 编码平台。',
  postUrl: '/blog/我们团队的teamagent让一群ai协作做需求',
};

const myContributions = [
  {
    title: '任务板：Agent 协作的唯一共享状态',
    detail:
      '用 JSON 文件做任务板，所有协作围绕它发生而非靠对话。原子锁认领解决并发冲突，blocked_by 字段自动驱动任务执行顺序。',
  },
  {
    title: '场景编排：阶段依赖图',
    detail:
      '把每种工作流抽象成 DAG（Spec→Design→Dev→Test→Review），阶段图是数据不是写死流程，按依赖关系驱动多角色并行与串行。',
  },
  {
    title: '会话恢复：从 GitLab 重建中断进度',
    detail:
      '三级回退算法（显式记录 → GitLab 快照 → 产出物），本地文件全丢也能接着跑，in_progress 任务自动重置并记中断工时。',
  },
  {
    title: 'worktree 隔离：多需求并行',
    detail:
      '每个 Issue 独立 git worktree + 分支 + MR，三四个需求可同时各跑一支队伍，互不踩代码。',
  },
];

// 其他 AI 能力实践（项目内工具性搭建 + 个人实践）
const personalAiPractices = [
  '为 TeamAgent 搭建知识库：Dify + 向量数据库，三类知识库检索（产品/IPD/技术）',
  'CodeGraph 集成：将 codegraph_explore 接入代码探索、调试、CodeReview 等 Skill，带两级降级容错',
  '单元测试 Agent：unit-test Skill，统一单测规范加载、工具链选择与覆盖率核对',
  '基于 Dify 搭建 RAG 流水线，跑通文档摄入 → 向量化 → 检索 → 生成完整链路',
  '本地部署 Qwen3-Coder-Next 80B 大模型，用于辅助修复日常代码 bug',
];

// 副业线 / AI 实践：把技术变成产品
const productExperiences = [
  {
    name: '卡雷达',
    tagline: '借助 AI 把想法快速变现',
    url: 'https://kaleida.com.cn',
    description:
      '一站式移动上网方案决策平台。我一个人 + Claude 全栈独立完成，上线首月收入破万；目前 600+ 用户、日活约 100、日均访问 600+，月均订单过百、收入稳定在 2000+。',
  },
  {
    name: '河北高考志愿助手',
    tagline: '用 AI 造真实产品',
    url: 'https://hbzhiyuan.site',
    description: '为河北考生量身定制的高考志愿辅助系统，AI 辅助从需求到落地的完整闭环。',
  },
  {
    name: 'DyHub',
    tagline: '开源 · AI 协作产物',
    url: 'https://github.com/ymstar/dyhub',
    description: '抖音弹幕中台，将直播间互动事件通过 WebSocket / SSE / Webhook 三通道分发。开源两个月获 44 star。',
  },
];

const techStack = [
  {
    category: '后端',
    items: ['Java', 'Spring Boot', 'Temporal', 'Redis', 'MySQL'],
  },
  {
    category: 'DevOps',
    items: ['Docker', 'Kubernetes', 'Jenkins', 'Nginx'],
  },
  {
    category: 'AI / Agent',
    items: ['Claude Code', 'Coze 工作流', 'Dify RAG', '向量数据库', '本地大模型部署'],
  },
];

const aiTools = [
  {
    name: 'Magpie',
    icon: '/ai-tools/magpie.png',
    url: 'https://github.com/yetone/magpie',
    description: '集中管理各个 Agent 的模型，菜单栏一键切换 Codex/Claude Code 背后的底层模型。',
  },
  {
    name: 'Orca',
    icon: '/ai-tools/orca.png',
    url: 'https://github.com/stablyai/orca',
    description: '为百倍效率创造者打造的 AI IDE，可并行调度 Claude Code、Codex 等 Agent 编队。',
  },
  {
    name: 'LMStudio (Bionic)',
    icon: '/ai-tools/lmstudio.png',
    url: 'https://lmstudio.ai/',
    description: '本地运行开源大模型，无需依赖云端 API，适合离线与隐私敏感场景。',
  },
  {
    name: 'CodeGraph',
    icon: '/ai-tools/codegraph.svg',
    url: 'https://github.com/colbymchenry/codegraph',
    description: '本地代码图谱赋能 Agent 开发，减少 token 消耗与工具调用次数。',
  },
];

const contacts = [
  { label: '邮箱', value: 'ymstar2026@163.com' },
  { label: '微信', value: 'SYM612ym' },
  { label: 'GitHub', value: 'github.com/ymstar', href: 'https://github.com/ymstar' },
  { label: '知乎', value: 'Coder-adai', href: 'https://www.zhihu.com/people/Coder-adai' },
];

---

<Base
  title="关于 · 阿呆"
  description="阿呆，软件工程师 & Indie Maker。从 Java / DevOps 走向 AI / Agent 方向。知乎【阿呆】，公众号【AI搞钱实战录】。"
>
  <div class="container-prose py-16 sm:py-20">
    <!-- ① 开场区 -->
    <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start">
      <img
        src="/avatar.jpeg"
        alt="阿呆"
        width="120"
        height="120"
        class="h-24 w-24 rounded-full border-4 border-surface-subtle object-cover shadow-md sm:h-30 sm:w-30"
      />
      <div class="text-center sm:text-left">
        <h1 class="text-3xl font-bold text-ink sm:text-4xl">阿呆</h1>
        <p class="mt-2 text-base text-ink-light sm:text-lg">
          软件工程师 &amp; Indie Maker · 从 Java/DevOps 走向 AI/Agent
        </p>
        <p class="mt-1 text-sm text-ink-muted">
          知乎【阿呆】 · 公众号【AI搞钱实战录】
        </p>
      </div>
    </div>

    <!-- ② 自我介绍 -->
    <div class="prose prose-slate mt-12 max-w-none prose-headings:text-ink prose-a:text-accent">
      <p>
        我是一名软件工程师，过去几年在公司内部做 DevOps 平台，
        从 0 到 1 搭建过 CI 体系和任务管理、制品管理两套子系统。
        与此同时，我一直在用 AI 做自己的产品 —— <a
          href="https://kaleida.com.cn"
          target="_blank"
          rel="noopener noreferrer">卡雷达</a
        > 一个人独立完成，上线首月收入破万，至今稳定运营。
      </p>
      <p>
        现在，我正在把重心从 Java 后端 / DevOps 转向 <strong>AI 和 Agent 方向</strong>。
        这个网站是我留给面试官的一张名片，也是我记录成长的地方。
        如果你也在探索 AI 落地、不愿待在舒适区，欢迎一起交流。
      </p>

      <!-- ③ 经历高光：公司线 -->
      <h2>经历</h2>
    </div>

    <div class="mt-6 space-y-6">
      {workExperiences.map((exp) => (
        <div class="card p-6">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-lg font-bold text-ink">{exp.role}</h3>
            <span class="text-sm text-ink-muted">{exp.period}</span>
          </div>
          <ul class="mt-4 space-y-2">
            {exp.highlights.map((h) => (
              <li class="flex gap-3 text-sm text-ink-light">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
                <span class="leading-relaxed">{h}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- AI 工程实践 -->
    <div class="prose prose-slate mt-12 max-w-none prose-headings:text-ink prose-a:text-accent">
      <h2>AI 工程实践</h2>
      <p class="text-sm text-ink-muted -mt-2">
        不只是会用 AI 工具，也在搭 AI 能力 —— MCP、多 Agent 编排、知识库、ToolUse。
      </p>
    </div>
    <div class="mt-6 space-y-3">
      <div class="card border-accent-light p-5">
        <h3 class="text-base font-bold text-ink">{teamAgent.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-light">{teamAgent.summary}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="tag">MCP</span>
          <span class="tag">多 Agent 编排</span>
          <span class="tag">ToolUse</span>
        </div>
        <a
          href={teamAgent.postUrl}
          class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-accent hover:text-accent-dark"
        >
          这套系统怎么落地的，我写了篇文章 →
        </a>
      </div>

      <p class="px-1 pt-2 text-xs font-semibold uppercase tracking-wide text-ink-muted">
        重点模块
      </p>
      {myContributions.map((item) => (
        <div class="card p-5">
          <h3 class="text-sm font-bold text-ink">{item.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-light">{item.detail}</p>
        </div>
      ))}

      <div class="card bg-surface-subtle p-5">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-ink-muted">其他 AI 能力实践</p>
        <ul class="space-y-2">
          {personalAiPractices.map((p) => (
            <li class="flex gap-3 text-sm text-ink-light">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ink-muted"></span>
              <span class="leading-relaxed">{p}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- ③ 经历高光：AI / 副业线 -->
    <div class="prose prose-slate mt-12 max-w-none prose-headings:text-ink prose-a:text-accent">
      <h2>用 AI 造产品</h2>
      <p class="text-sm text-ink-muted -mt-2">
        把想法快速变成能用的、能赚钱的产品 —— 这是 AI 给我最大的杠杆。
      </p>
    </div>

    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {productExperiences.map((p) => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          class="card card-hover group flex flex-col gap-3 p-6"
        >
          <div class="flex items-baseline justify-between gap-2">
            <h3 class="text-lg font-bold text-ink group-hover:text-accent">{p.name}</h3>
            <span class="shrink-0 text-xs text-ink-muted group-hover:text-accent">↗</span>
          </div>
          <p class="text-sm font-medium text-accent">{p.tagline}</p>
          <p class="text-sm leading-relaxed text-ink-light">{p.description}</p>
        </a>
      ))}
    </div>

    <!-- ④ 教育背景 -->
    <div class="prose prose-slate mt-12 max-w-none prose-headings:text-ink prose-a:text-accent">
      <h2>教育背景</h2>
    </div>
    <div class="mt-6">
      <div class="card p-6">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <h3 class="text-lg font-bold text-ink">西安科技大学 · 本科</h3>
          <span class="text-sm text-ink-muted">2020 届</span>
        </div>
      </div>
    </div>

    <!-- ⑤ 技术栈 -->
    <div class="prose prose-slate mt-12 max-w-none prose-headings:text-ink prose-a:text-accent">
      <h2>技术栈</h2>
    </div>
    <div class="mt-6 space-y-5">
      {techStack.map((group) => (
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
          <span class="w-20 shrink-0 text-sm font-semibold text-ink-light">{group.category}</span>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="tag">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- ⑥ 日常 AI 工具 -->
    <div class="prose prose-slate mt-12 max-w-none prose-headings:text-ink prose-a:text-accent">
      <h2>日常 AI 工具</h2>
      <p class="text-sm text-ink-muted -mt-2">日常开发中高频使用的 AI 利器</p>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {aiTools.map((tool) => (
        <a
          href={tool.url}
          target="_blank"
          rel="noopener noreferrer"
          class="card card-hover group flex items-start gap-4 p-5"
        >
          <img
            src={tool.icon}
            alt={tool.name}
            width="40"
            height="40"
            class="h-10 w-10 shrink-0 rounded-lg object-contain"
          />
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="text-base font-bold text-ink group-hover:text-accent">{tool.name}</h3>
              <span class="shrink-0 text-xs text-ink-muted group-hover:text-accent">↗</span>
            </div>
            <p class="mt-1 text-sm leading-relaxed text-ink-light">{tool.description}</p>
          </div>
        </a>
      ))}
    </div>

    <!-- ⑦ 联系方式 -->
    <div class="prose prose-slate mt-12 max-w-none prose-headings:text-ink prose-a:text-accent">
      <h2>联系方式</h2>
    </div>
    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      {contacts.map((c) => (
        <div class="card flex items-center justify-between gap-3 p-4">
          <span class="text-sm text-ink-muted">{c.label}</span>
          {c.href ? (
            <a
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium text-ink hover:text-accent"
            >
              {c.value}
            </a>
          ) : (
            <span class="text-sm font-medium text-ink">{c.value}</span>
          )}
        </div>
      ))}
    </div>
  </div>
</Base>
