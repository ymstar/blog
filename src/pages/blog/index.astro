---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 按年份分组
const postsByYear = allPosts.reduce((acc, post) => {
  const year = post.data.pubDate.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof allPosts>);

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);

// 分类统计
const categoryCount = allPosts.reduce((acc, post) => {
  acc[post.data.category] = (acc[post.data.category] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
const categories = Object.entries(categoryCount).sort((a, b) => b[1] - a[1]);

// 分类颜色映射
const categoryColors: Record<string, string> = {
  '并发': 'bg-blue-100 text-blue-700',
  'java': 'bg-orange-100 text-orange-700',
  'Java': 'bg-orange-100 text-orange-700',
  'java源码': 'bg-amber-100 text-amber-700',
  'Docker': 'bg-cyan-100 text-cyan-700',
  'Linux': 'bg-green-100 text-green-700',
  'Spring': 'bg-green-100 text-green-700',
  'Temporal': 'bg-violet-100 text-violet-700',
  '博客搭建': 'bg-pink-100 text-pink-700',
  '设计模式': 'bg-purple-100 text-purple-700',
  'DevOps': 'bg-indigo-100 text-indigo-700',
};
const defaultColor = 'bg-slate-100 text-slate-700';
---

<Base title="博客 · 阿呆" description="阿呆的技术博客，分享 Java、并发编程、分布式系统、Docker、Linux、Temporal 等技术笔记与心得。">
  <!-- 头部 -->
  <section class="border-b border-surface-border bg-surface-subtle">
    <div class="container-prose py-12 sm:py-16">
      <h1 class="text-3xl font-bold text-ink sm:text-4xl">博客</h1>
      <p class="mt-3 text-ink-light">
        共 {allPosts.length} 篇文章，{categories.length} 个分类
      </p>

      <!-- 分类筛选 -->
      <div class="mt-6 flex flex-wrap gap-2">
        {categories.map(([cat, count]) => (
          <span class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm font-medium ${categoryColors[cat] || defaultColor}`}>
            {cat}
            <span class="text-xs opacity-60">{count}</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- 文章列表 -->
  <div class="container-prose py-12 sm:py-16">
    {years.map((year) => (
      <section class="mb-14">
        <div class="mb-6 flex items-center gap-3">
          <h2 class="text-2xl font-bold text-ink">{year}</h2>
          <span class="h-px flex-1 bg-surface-border"></span>
          <span class="text-sm text-ink-muted">{postsByYear[year].length} 篇</span>
        </div>

        <div class="grid gap-3">
          {postsByYear[year].map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="card card-hover group flex items-center gap-4 p-5"
            >
              <!-- 日期 -->
              <time class="shrink-0 text-sm font-medium text-ink-muted tabular-nums">
                {post.data.pubDate.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
              </time>

              <!-- 分隔线 -->
              <span class="h-8 w-px shrink-0 bg-surface-border"></span>

              <!-- 标题 -->
              <span class="flex-1 text-base font-medium text-ink group-hover:text-accent transition-colors">
                {post.data.title}
              </span>

              <!-- 分类标签 -->
              <span class={`shrink-0 rounded-full px-2.5 py-1 text-xs font-medium ${categoryColors[post.data.category] || defaultColor}`}>
                {post.data.category}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
